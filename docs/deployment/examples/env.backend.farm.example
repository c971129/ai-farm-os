# 后端环境变量示例 — farm.lcxlwh.com / 47.94.243.26
# 复制到服务器 /opt/ai-farm-os/.env 后填写，权限 600。勿提交真实密钥。

AI_FARM_PORT=8080
AI_FARM_ALLOWED_HOSTS=farm.lcxlwh.com,127.0.0.1,localhost
# JSDMirror 前端 Origin 必须在此白名单；Pages 入口 Origin 也必须包含
AI_FARM_ALLOWED_ORIGINS=https://c971129.github.io,https://cdn.jsdmirror.com,https://farm.lcxlwh.com

# 厂家只读采集（仅服务器）
SENOIOT_ENABLED=1
SENOIOT_ACCOUNT=
SENOIOT_PASSWORD=
SENOIOT_POLL_SECONDS=60
SENOIOT_HISTORY_SECONDS=300
SENOIOT_BACKFILL_HOURS=1
SENOIOT_STALE_SECONDS=1800

# 可选：农事助手 / OpenAI（不要写进公开前端）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
