# 复制为 .env 后填入（勿提交真实密钥）
# 启动 start-web.ps1 时会自动加载，用于农事助手 / AI 对话调用 GPT 额度
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 设备接入：仅后台读取，不能加到前端或提交真实密码。
# 使用 start.bat 启动；部署到服务器时可改用进程环境变量。
SENOIOT_ENABLED=1
SENOIOT_ACCOUNT=
SENOIOT_PASSWORD=
SENOIOT_POLL_SECONDS=60
SENOIOT_HISTORY_SECONDS=300
SENOIOT_BACKFILL_HOURS=1
SENOIOT_STALE_SECONDS=1800

# 拆分部署（JSDMirror 前端 + 远程 API）时在服务器设置：
# AI_FARM_ALLOWED_HOSTS=farm.yijxj.com,127.0.0.1,localhost
# AI_FARM_ALLOWED_ORIGINS=https://cdn.jsdmirror.com,https://farm.yijxj.com
